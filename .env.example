# Copy this file to `.env` and fill in your keys. Never commit the real `.env`.
#
# Development-only. This is for the coding agent you work in this repo with,
# not for the tool: tsx-reader-export makes no network requests and needs no
# credentials to bundle, render or export a canvas. Nothing in src/ or scripts/
# reads it, so leaving it unset only affects the agent, not the build.
SERPER_API_KEY=your_serper_api_key_here
